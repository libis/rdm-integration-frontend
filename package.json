{
  "name": "datasync",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "lint": "eslint \"src/**/*.{js,ts}\" && npm run lint:unused-exports",
    "lint:unused-exports": "node scripts/check-unused-exports.mjs",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,html,css,scss}\"",
    "pretty:check": "prettier --check \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,html,css,scss}\"",
    "analyze": "ng build --configuration production --source-map && npx webpack-bundle-analyzer dist/datasync/*.js",
    "serve:prod": "ng serve --configuration production"
  },
  "private": true,
  "resolutions": {
    "typescript": "~6.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/cli": "^22.1.8",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/localize": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@ro-kit/ui-widgets": "^1.0.63",
    "bootstrap": "^5.3.8",
    "jsonld": "^9.0.0",
    "lit": "^3.3.3",
    "n3": "^2.7.12",
    "ngx-autosize": "^2.0.4",
    "primeicons": "^7.0.0",
    "rdfxml-streaming-parser": "^3.3.0",
    "rxjs": "^7.8.2",
    "shacl-engine": "^1.1.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/build": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/n3": "^1.26.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^17.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^7.0.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "prettier": "^3.9.8",
    "terser": "^5.51.2",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "webpack-bundle-analyzer": "^5.4.0"
  }
}
